{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "factory",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },

  "vars": {
    // Linear workflow state names (must match your team's statuses exactly).
    "AGENT_READY_STATE": "Agent Ready",
    "AGENT_WORKING_STATE": "Agent Working",
    "NEEDS_HUMAN_STATE": "Needs Human",
    // Blocked tickets are released when their blockers are done (state and label names).
    "BLOCKED_STATE": "Blocked",
    "TODO_STATE": "Todo",
    "AUTO_START_LABEL": "Auto-start",
    "MANUAL_LABEL": "factory:manual",

    // The GitHub user or organization that owns the factory and the app repos.
    "GITHUB_OWNER": "kverburg",

    // Linear project name -> GitHub repo name ("owner/repo" also works). One line per app.
    "PROJECT_REPOS": {
      "Factory": "factory",
      "Backpack": "backpack",
      "Feast": "feast"
    }
  },

  // Worker Previews (PR branches, built by Cloudflare with `npx wrangler preview`).
  // Previews don't inherit the settings above, so they're repeated here, except that
  // a preview never starts real builds (no repos) and gets no secrets: without
  // LINEAR_WEBHOOK_SECRET it rejects every webhook, and only answers GET / as a smoke
  // test. Never copy production secrets into this block or the Previews Base settings.
  "previews": {
    "vars": {
      "AGENT_READY_STATE": "Agent Ready",
      "AGENT_WORKING_STATE": "Agent Working",
      "NEEDS_HUMAN_STATE": "Needs Human",
      "BLOCKED_STATE": "Blocked",
      "TODO_STATE": "Todo",
      "AUTO_START_LABEL": "Auto-start",
      "MANUAL_LABEL": "factory:manual",
      "GITHUB_OWNER": "kverburg",
      "PROJECT_REPOS": {}
    }
  }

  // Secrets are NOT stored here. They come from Infisical (/cloudflare/factory-relay),
  // synced to the Worker as type "Secret": LINEAR_API_KEY, LINEAR_WEBHOOK_SECRET, GITHUB_TOKEN
}
